# Single user (required)
APP_USERNAME=admin
APP_PASSWORD=change-me-please

# Optional: stable session signing key (random string). If empty, derived from credentials.
SESSION_SECRET=

# Optional: set to true when served over HTTPS through a reverse proxy
COOKIE_SECURE=false

# Optional: fraction of zone pixels that must change to count as motion (0-1)
MOTION_THRESHOLD=0.02

# Optional: host port mapping
WATCHDOG_PORT=8099

TZ=UTC
